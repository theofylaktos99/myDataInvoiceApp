{
  "name": "@mydata/kandavlos",
  "version": "1.2.0",
  "description": "Kandavlos Invoice Management System",
  "main": "electron.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "cross-env ELECTRON=1 vite build",
    "electron:dist": "cross-env NODE_ENV=production electron-builder",
    "electron:build": "npm run build && npm run electron:dist"
  },
  "dependencies": {
    "@mydata/core": "*",
    "electron-updater": "^6.6.2",
    "keytar": "^7.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.16",
    "@vitejs/plugin-react": "^5.1.0",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "electron": "^31.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.16",
    "vite": "^7.1.12"
  },
  "build": {
    "appId": "com.kandavlos.invoice",
    "productName": "Kandavlos Invoice",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      { "from": "dist", "to": "dist", "filter": ["**/*"] },
      "electron.cjs",
      "preload.js",
      "node_modules/**/*",
      "package.json"
    ],
    "extraMetadata": { "main": "electron.cjs" },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "publish": {
      "provider": "github",
      "owner": "theofylaktos99",
      "repo": "myDataInvoiceApp"
    }
  }
}
